# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Environment variables ────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Do NOT ignore .env.example — it is committed as a template
!.env.example

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
ENV/
*.egg-info/
dist-info/
*.egg
pip-wheel-metadata/
.Python
.mypy_cache/
.dmypy.json
.pytype/
.pyre/

# ─── Hardhat / Blockchain ─────────────────────────────────────────────────────
blockchain/artifacts/
blockchain/cache/
blockchain/deployments/
# Keep example deployment JSON as reference
!blockchain/deployments/*.example.json
typechain-types/

# ─── ML model weights ─────────────────────────────────────────────────────────
*.pt
*.pth
*.onnx
*.h5
*.safetensors
*.bin
ai-verification/models/*
!ai-verification/models/.gitkeep
ai-verification/dataset/*
!ai-verification/dataset/.gitkeep

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/
.expo/
.expo-shared/
web-build/
ios/
android/

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ─── OS generated ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Test coverage ────────────────────────────────────────────────────────────
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*
.pytest_cache/
__snapshots__/

# ─── Package manager locks (keep yarn.lock / package-lock.json) ───────────────
